# ==============================================================================
# Ambiente e Configurações - usuarioService (Portal TADS)
# ==============================================================================
# Renomeie ou copie este arquivo para .env caso utilize carregador de variáveis
# ou configure essas variáveis no seu ambiente de execução / docker-compose.
# ==============================================================================

# Porta da aplicação
SERVER_PORT=8081

# Context path base dos endpoints
SERVER_CONTEXT_PATH=/api/usuarios/

# Conexão com o Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=usuarioDB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=adm

# URL completa do JDBC
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Configurações de Segurança e JWT
# Segredo Base64 para assinatura do token (mínimo 256 bits para HMAC-SHA256)
JWT_SECRET=14I15oujcYSvV7r7Lghmg+HUMJ5n8YXDYmQoyHFiWMA=

# Tempo de expiração do token em milissegundos (ex: 36000000 ms = 10 horas)
JWT_EXPIRATION=36000000
